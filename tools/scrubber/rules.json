{
  "_comment": "Generic, publishable redaction rules. Project-specific secret strings (real hostnames, program slugs, operator IDs) do NOT belong here — put them in a local, gitignored denylist passed via --denylist. 'verify: true' rules are re-checked after scrubbing as a fail-closed double-check.",

  "patterns": [
    {
      "name": "private-key-block",
      "regex": "-----BEGIN (?:RSA |EC |OPENSSH |DSA |PGP )?PRIVATE KEY-----",
      "placeholder": "[REDACTED_PRIVATE_KEY]",
      "verify": true
    },
    {
      "name": "aws-access-key",
      "regex": "\\b(?:AKIA|ASIA)[0-9A-Z]{16}\\b",
      "placeholder": "[REDACTED_AWS_KEY]",
      "verify": true
    },
    {
      "name": "github-token",
      "regex": "\\bgh[pousr]_[A-Za-z0-9]{20,}\\b",
      "placeholder": "[REDACTED_GH_TOKEN]",
      "verify": true
    },
    {
      "name": "slack-token",
      "regex": "\\bxox[baprs]-[A-Za-z0-9-]{10,}\\b",
      "placeholder": "[REDACTED_SLACK_TOKEN]",
      "verify": true
    },
    {
      "name": "fernet-key",
      "regex": "\\b[A-Za-z0-9_\\-]{43}=\\b",
      "placeholder": "[REDACTED_FERNET_KEY]",
      "verify": false
    },
    {
      "name": "email",
      "regex": "\\b[A-Za-z0-9._%+\\-]+@[A-Za-z0-9.\\-]+\\.[A-Za-z]{2,}\\b",
      "placeholder": "[REDACTED_EMAIL]",
      "verify": true
    },
    {
      "name": "rfc1918-ipv4",
      "regex": "\\b(?:10\\.(?:\\d{1,3})\\.(?:\\d{1,3})\\.(?:\\d{1,3})|172\\.(?:1[6-9]|2\\d|3[01])\\.(?:\\d{1,3})\\.(?:\\d{1,3})|192\\.168\\.(?:\\d{1,3})\\.(?:\\d{1,3}))\\b",
      "placeholder": "[REDACTED_RFC1918_IP]",
      "verify": true
    }
  ],

  "block_globs": [
    "keys",
    "ledger",
    "identities",
    "policies",
    "*.key",
    "*.pem",
    "*.p12",
    "*.pfx",
    "*vault*",
    "**/keys/**",
    "**/ledger/**",
    "**/identities/**",
    "**/policies/**",
    "scopes/**",
    "docs/**",
    "redteam/**",
    "runs/**",
    "*.env",
    ".env*"
  ],

  "skip_globs": [
    ".git/**",
    "**/__pycache__/**",
    "**/.pytest_cache/**",
    "**/*.pyc",
    ".DS_Store"
  ],

  "binary_suffixes": [
    ".png", ".jpg", ".jpeg", ".gif", ".ico", ".pdf", ".zip", ".gz",
    ".tar", ".db", ".sqlite", ".so", ".dylib", ".bin", ".woff", ".woff2"
  ]
}
